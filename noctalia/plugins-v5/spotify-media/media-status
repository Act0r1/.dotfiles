#!/usr/bin/env bash
set -u

player="playerctld"
if ! playerctl -p "$player" status >/dev/null 2>&1; then
  player="$(playerctl -l 2>/dev/null | head -n 1 || true)"
fi

if [[ -z "$player" ]] || ! playerctl -p "$player" status >/dev/null 2>&1; then
  jq -nc '{available:false,title:"Nothing playing",artist:"Media",album:"",artUrl:"",status:"Stopped",position:0,length:0,player:"",source:"Media",isSpotify:false}'
  exit 0
fi

title="$(playerctl -p "$player" metadata xesam:title 2>/dev/null || true)"
artist="$(playerctl -p "$player" metadata xesam:artist 2>/dev/null || true)"
album="$(playerctl -p "$player" metadata xesam:album 2>/dev/null || true)"
art_url="$(playerctl -p "$player" metadata mpris:artUrl 2>/dev/null || true)"
track_url="$(playerctl -p "$player" metadata xesam:url 2>/dev/null || true)"
track_id="$(playerctl -p "$player" metadata mpris:trackid 2>/dev/null || true)"
status="$(playerctl -p "$player" status 2>/dev/null || true)"
position="$(playerctl -p "$player" position 2>/dev/null || printf '0')"
length_us="$(playerctl -p "$player" metadata mpris:length 2>/dev/null || printf '0')"

is_spotify=false
source="Media"
if [[ "$track_url" == https://open.spotify.com/* || "$track_id" == /com/spotify/* || "$player" == spotify* ]]; then
  is_spotify=true
  source="Spotify"
elif [[ "$track_url" =~ ^https?://([^/]+) ]]; then
  source="${BASH_REMATCH[1]#www.}"
elif [[ "$player" != "playerctld" ]]; then
  source="${player%%.*}"
fi

jq -nc \
  --arg title "$title" \
  --arg artist "$artist" \
  --arg album "$album" \
  --arg artUrl "$art_url" \
  --arg status "$status" \
  --arg position "$position" \
  --arg lengthUs "$length_us" \
  --arg player "$player" \
  --arg source "$source" \
  --argjson isSpotify "$is_spotify" \
  '{
    available: true,
    title: $title,
    artist: $artist,
    album: $album,
    artUrl: $artUrl,
    status: $status,
    position: (($position | tonumber?) // 0),
    length: ((($lengthUs | tonumber?) // 0) / 1000000),
    player: $player,
    source: $source,
    isSpotify: $isSpotify
  }'
