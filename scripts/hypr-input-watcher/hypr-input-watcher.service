[Unit]
Description=Hyprland Input Watcher (Restarts Espanso)
After=hyprland-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env uv run %h/.dotfiles/scripts/hypr-input-watcher/main.py
WorkingDirectory=%h/.dotfiles/scripts/hypr-input-watcher
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
